EMB_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_EMBED_MODEL=models/gemini-embedding-001

OPENAI_API_KEY=
OPENAI_EMBED_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
MINIMAX_API_KEY=
OLLAMA_MODEL=llama4
OLLAMA_EMBED_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMP=0.7
LLM_MAXTOK=8192

TTS_PROVIDER=edge
