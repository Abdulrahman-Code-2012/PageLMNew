# PageLM backend environment template
NODE_ENV=production
PORT=10000
HOST=0.0.0.0

CORS_ORIGINS=https://pagelmai.netlify.app

VITE_BACKEND_URL=https://YOUR-RENDER-SERVICE.onrender.com
VITE_FRONTEND_URL=https://pagelmai.netlify.app

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
